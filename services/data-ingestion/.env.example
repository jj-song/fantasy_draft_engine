# Data Ingestion Service Environment Configuration

# Service Configuration
ENV=production
LOG_LEVEL=INFO
PORT=8000

# External Service URLs
CONFIG_SERVICE_URL=http://configuration:8000

# Data Configuration
DATA_START_YEAR=2010
DATA_END_YEAR=2025

# NFL Data API Configuration
NFL_DATA_TIMEOUT=30
NFL_DATA_RETRIES=3

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# Logging Configuration
LOG_FILE_PATH=/app/logs/data-ingestion.log
LOG_ROTATION_SIZE=10MB
LOG_BACKUP_COUNT=5